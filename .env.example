# Copy to .env and fill in. .env is gitignored; never commit a real key.

# Required. Create one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# Host port for the web UI. Published on 127.0.0.1 only; see README "Security".
PORT=4096

# opencode release built into the image. Must match a published version of the
# opencode-ai npm package.
OPENCODE_VERSION=1.18.30

# The uid/gid the agent runs as inside the container. It must match the owner of
# the workspace directory, or the agent can read your project but not edit it.
# Check yours with `id -u` and `id -g`. Leave these alone on macOS.
UID=1000
GID=1000
