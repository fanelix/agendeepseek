# Copy to .env and fill in. .env is gitignored; never commit a real key.

# Required. Create one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# Host port for the web UI. Published on 127.0.0.1 only; see README "Security".
PORT=4096

# opencode release built into the image. Must match a published version of the
# opencode-ai npm package.
OPENCODE_VERSION=1.18.30
